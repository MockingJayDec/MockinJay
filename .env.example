# MockinJay 환경 변수 설정 예시
# 실제 사용 시 .env 파일로 복사하여 값을 채워주세요

# 환경 설정
ENVIRONMENT=development  # development, staging, production
PROJECT_NAME=MockinJay
VERSION=0.1.0

# API 설정
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM API 키
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Vector Database (Pinecone)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment

# PostgreSQL Database
DATABASE_URL=postgresql://user:password@localhost:5432/mockinjay

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# PubMed API
PUBMED_API_KEY=your-pubmed-api-key-here
PUBMED_EMAIL=your-email@example.com

# 로깅
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FILE=logs/app.log

# 보안
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 서버 설정
HOST=0.0.0.0
PORT=8000
RELOAD=true  # development 환경에서만 true
