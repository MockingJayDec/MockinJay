# ============================================
# MockinJay 환경 변수 설정 예시
# ============================================
# 이 파일을 복사하여 .env 파일을 생성하고 실제 값으로 변경하세요
# cp .env.example .env


# ============================================
# 프로젝트 기본 설정
# ============================================

# 환경 (development, staging, production)
ENVIRONMENT=development

# 프로젝트 이름
PROJECT_NAME=MockinJay

# 버전
VERSION=0.1.0

# CORS 허용 오리진 (쉼표로 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000


# ============================================
# LLM API 설정 (하나 이상 필수)
# ============================================

# OpenAI API 키
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic Claude API 키
# 발급: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# 사용할 LLM 제공자 (openai 또는 anthropic)
LLM_PROVIDER=openai

# LLM 모델 이름
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# LLM API 타임아웃 (초)
LLM_TIMEOUT=30


# ============================================
# Vector Database (Qdrant) 설정
# ============================================

# Qdrant 호스트
QDRANT_HOST=localhost

# Qdrant 포트
QDRANT_PORT=6333

# Qdrant API 키 (클라우드 사용 시)
# 로컬 실행 시 비워두거나 제거
QDRANT_API_KEY=

# Qdrant URL (전체 URL 사용 시)
# QDRANT_URL=http://localhost:6333

# Qdrant 컬렉션 이름
QDRANT_COLLECTION_QNA=qna_db
QDRANT_COLLECTION_PAPER=paper_db
QDRANT_COLLECTION_POLICY=policy_db


# ============================================
# Embedding 모델 설정
# ============================================

# Embedding 모델 제공자 (openai 또는 sentence-transformers)
EMBEDDING_PROVIDER=openai

# OpenAI Embedding 모델
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Sentence-Transformers 모델
SENTENCE_TRANSFORMER_MODEL=paraphrase-multilingual-mpnet-base-v2

# Embedding 차원
EMBEDDING_DIMENSION=1536


# ============================================
# Redis Cache 설정 (선택사항)
# ============================================

# Redis 호스트
REDIS_HOST=localhost

# Redis 포트
REDIS_PORT=6379

# Redis 비밀번호 (없으면 비워두기)
REDIS_PASSWORD=

# Redis 데이터베이스 번호
REDIS_DB=0

# Redis URL (전체 URL 사용 시)
# REDIS_URL=redis://localhost:6379/0

# 캐시 만료 시간 (초)
INTENT_CACHE_TTL=3600      # 의도 분류: 1시간
RAG_CACHE_TTL=86400        # RAG 검색: 24시간


# ============================================
# PubMed API 설정 (RESEARCH 의도용)
# ============================================

# PubMed API 이메일 (필수)
# NCBI에서 요구하는 연락처 정보
PUBMED_EMAIL=your-email@example.com

# PubMed API 키 (선택, 요청 제한 완화)
# 발급: https://www.ncbi.nlm.nih.gov/account/
PUBMED_API_KEY=

# PubMed 검색 최대 결과 수
PUBMED_MAX_RESULTS=10


# ============================================
# 로깅 설정
# ============================================

# 로그 레벨 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# 로그 파일 경로
LOG_FILE=logs/app.log

# 로그 포맷
# simple: 간단한 포맷
# detailed: 상세한 포맷 (파일명, 줄 번호 포함)
LOG_FORMAT=detailed

# 콘솔 로그 활성화
LOG_TO_CONSOLE=true

# 파일 로그 활성화
LOG_TO_FILE=true


# ============================================
# 성능 모니터링 설정
# ============================================

# 성능 메트릭 수집 활성화
PERFORMANCE_MONITORING_ENABLED=true

# 성능 임계값 - 응답 시간 (초)
PERFORMANCE_THRESHOLD_RESPONSE_TIME=25.0

# 성능 임계값 - 의도 분류 정확도 (0.0 ~ 1.0)
PERFORMANCE_THRESHOLD_ACCURACY=0.90

# 성능 임계값 - 에러율 (0.0 ~ 1.0)
PERFORMANCE_THRESHOLD_ERROR_RATE=0.01


# ============================================
# 안전 장치 설정
# ============================================

# 응급 상황 감지 활성화
EMERGENCY_DETECTION_ENABLED=true

# 의료 판단 차단 활성화
MEDICAL_JUDGMENT_BLOCKING_ENABLED=true

# 비윤리적 질문 필터링 활성화
NON_ETHICAL_FILTERING_ENABLED=true


# ============================================
# RAG 검색 설정
# ============================================

# 검색 결과 최대 개수
RAG_TOP_K=5

# 유사도 임계값 (0.0 ~ 1.0)
RAG_SIMILARITY_THRESHOLD=0.7

# PubMed API 사용 활성화 (RESEARCH 의도)
RAG_USE_PUBMED=true


# ============================================
# 문서 요약 설정
# ============================================

# 요약 최대 길이 (단어)
SUMMARY_MAX_WORDS=150

# 요약 최소 길이 (단어)
SUMMARY_MIN_WORDS=100

# 배치 요약 최대 개수
SUMMARY_BATCH_SIZE=5


# ============================================
# API 서버 설정
# ============================================

# 서버 호스트
HOST=0.0.0.0

# 서버 포트
PORT=8000

# 자동 재시작 (development 환경에서만 true)
RELOAD=true

# Worker 프로세스 수 (production 환경)
WORKERS=4

# 요청 타임아웃 (초)
REQUEST_TIMEOUT=30


# ============================================
# 보안 설정 (production 환경 필수)
# ============================================

# Secret Key (JWT 토큰 서명 등)
# 생성: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# JWT 알고리즘
ALGORITHM=HS256

# Access Token 만료 시간 (분)
ACCESS_TOKEN_EXPIRE_MINUTES=30


# ============================================
# 데이터베이스 설정 (향후 사용)
# ============================================

# PostgreSQL 데이터베이스 URL
# DATABASE_URL=postgresql://user:password@localhost:5432/mockinjay

# 데이터베이스 풀 설정
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20


# ============================================
# 개발 도구 설정
# ============================================

# Swagger UI 활성화 (production에서는 false)
ENABLE_DOCS=true

# ReDoc 활성화 (production에서는 false)
ENABLE_REDOC=true

# Debug 모드 (production에서는 절대 true로 설정 금지)
DEBUG=false


# ============================================
# 주석 안내
# ============================================
#
# 필수 환경 변수:
# - OPENAI_API_KEY 또는 ANTHROPIC_API_KEY (하나 이상)
# - QDRANT_HOST, QDRANT_PORT
# - PUBMED_EMAIL
#
# 선택 환경 변수:
# - REDIS_HOST, REDIS_PORT (캐싱 성능 향상)
# - PUBMED_API_KEY (요청 제한 완화)
# - QDRANT_API_KEY (클라우드 사용 시)
#
# Production 체크리스트:
# - [ ] SECRET_KEY 변경 (openssl rand -hex 32)
# - [ ] DEBUG=false 설정
# - [ ] RELOAD=false 설정
# - [ ] LOG_LEVEL=WARNING 또는 ERROR
# - [ ] ENABLE_DOCS=false (선택)
# - [ ] WORKERS=4 이상
# - [ ] ALLOWED_ORIGINS 실제 도메인으로 변경
#
